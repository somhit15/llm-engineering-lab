# Choose: google_genai or nvidia
LC_PROVIDER=google_genai

# Set a model ID available to your account.
LC_MODEL=gemini-2.5-flash

# Add at least the key for the provider you selected.
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Optional LangSmith tracing (configure later when ready)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
